# Required before production deployment
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example
COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true

POSTGRES_DB=nexage
POSTGRES_USER=nexage
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Configure with your transactional SMTP provider
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
SALES_ENQUIRY_EMAIL=sales@example.com
SEND_CUSTOMER_CONFIRMATION=false

# Same-origin frontend/backend proxy
VITE_API_BASE_URL=/api
